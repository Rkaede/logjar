{
  "manifest_version": 3,
  "name": "Logjar",
  "version": "0.0.0",
  "version_name": "0.0.0-pre.3",
  "description": "Optional Logjar Chrome extension for frontend log capture.",
  "minimum_chrome_version": "111",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.iife.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Logjar"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.iife.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page-bridge.iife.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
